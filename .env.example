NODE_ENV=development
PORT=3003
APP_BASE_URL=http://localhost:3003
# Browser authorization origin (no path).
RITA_PORTAL_URL=http://localhost:3000
# Server API base URL: frontend proxy /api, or direct backend http://localhost:4000.
RITA_API_URL=http://localhost:3000/api
RITA_CLIENT_ID=replace-me
RITA_CLIENT_SECRET=replace-me

# Absolute local session lifetime; refresh does not extend it (0 < hours <= 24).
SESSION_MAX_AGE_HOURS=8
# Maximum anonymous and authenticated RAM entries, without eviction.
MAX_SESSION_ENTRIES=10000
