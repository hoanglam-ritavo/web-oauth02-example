<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Rita OAuth Example</title>
  <link rel="stylesheet" href="/assets/app.css">
  <script src="/assets/axios.min.js" defer></script>
  <script src="/assets/app.js" defer></script>
</head>
<body><main data-authenticated="<%= Boolean(status) %>">
  <h1>Rita OAuth Example</h1>
  <p>Đăng nhập qua Rita Võ ID. Ứng dụng giữ token ở backend; browser chỉ giữ cookie phiên.</p>
  <p id="notice" role="status" aria-live="polite"><%= message ?? '' %></p>
  <% if (status) { %>
    <section id="identity"><h2>Profile từ Rita ID</h2><pre id="profile">Đang tải…</pre></section>
    <div class="actions">
      <button id="load-profile" type="button">Lấy profile</button>
      <button id="load-private" type="button">Gọi API private</button>
    </div>
    <h2>Trạng thái phiên</h2><pre id="session"><%= JSON.stringify(status, null, 2) %></pre>
    <% if (status.canRefresh) { %>
      <form method="post" action="/auth/refresh" id="refresh-form">
        <input type="hidden" name="csrf" value="<%= csrf ?? '' %>">
        <button type="submit">Refresh ngay</button>
      </form>
    <% } else { %><p>Không có refresh token; đăng nhập lại khi access token hết hạn.</p><% } %>
    <h2>Kết quả API private</h2><pre id="result">Chưa gọi API.</pre>
  <% } else { %><a href="/auth/login">Login with Rita Võ</a><% } %>
  <% if (csrf) { %>
    <form method="post" action="/auth/logout" id="logout-form">
      <input type="hidden" name="csrf" value="<%= csrf %>">
      <button type="submit">Đăng xuất app mẫu</button>
    </form>
  <% } %>
  <p><a href="/">Tải lại / thử lại</a></p>
  <footer>Demo một tiến trình, dữ liệu phiên lưu trong RAM. Logout app không logout SSO Rita ID.</footer>
</main></body>
</html>
