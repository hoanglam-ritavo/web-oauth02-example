EXAMPLE_MODE=mobile
NODE_ENV=development
PORT=3004
# For a physical device, bind a reachable interface (e.g. 0.0.0.0) in controlled LAN testing.
HOST=127.0.0.1
# API base URL: portal /api proxy, or direct backend http://localhost:4000.
RITA_API_URL=http://localhost:3000/api
RITA_MOBILE_CLIENT_ID=replace-with-public-mobile-client-id
# Absolute lifetime of X; OAuth refresh does not extend it (0 < hours <= 24).
MOBILE_SESSION_MAX_AGE_HOURS=8
MOBILE_MAX_SESSION_ENTRIES=1000
MOBILE_MAX_HANDOFF_ENTRIES=2000
